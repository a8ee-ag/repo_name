class Chocolate:
  def __init__(self, price: float, fill: str = ""):
    if price <= 0:
      raise ValueError("Price of the bar must be above Zero")
    self.price = price
    self.fill = fill

  def show_my_chocolate(self):
    if self.fill:
      print(f"Bar have filling: {self.fill}")
    else:
      print("Its regular bar")

  def __str__(self):
    return f"Chocolate bar. Price is {self.price} rubs"
