class Chocolate:
  def __init__(self, price: float, fill: str = ""):
    if price <= 0:
      raise ValueError("Price of the bar must be above Zero")
    self.price = price
    self.fill = fill

  def show_my_chocolate(self):
    if self.fill:
      print(f"Bar have filling: {self.fill}")
    else:
      print("Its regular bar")

  def __str__(self):
    return f"Chocolate bar. Price is {self.price} rubs"


if __name__ == "__main__":

  nutty = Chocolate(99.0, "hazelnut")
  print(nutty)
  nutty.show_my_chocolate()

  print("-" * 30)

  berry = Chocolate(120.0, "cranberry")
  print(berry)
  berry.show_my_chocolate()

  print("-" * 30)

  plain = Chocolate(75.5)
  print(plain)
  plain.show_my_chocolate()

  print("-" * 30)

  try:
    broken = Chocolate(-10.0, "raisins")
  except ValueError as e:
    print(f"Error: {e}")
